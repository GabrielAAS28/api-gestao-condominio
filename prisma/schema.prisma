// CONDIGTAL — Schema Prisma (convertido do Spring Boot / JPA)
// Os nomes de tabelas e colunas seguem o padrão original (GC_*) para manter
// compatibilidade com os scripts SQL existentes em `Banco/`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SINDICO
  MORADOR
  FUNCIONARIO_ADM
  PORTEIRO
  ADMIN
}

enum PessoaTipo {
  F // Física
  J // Jurídica
}

enum CondominioTipologia {
  RESIDENCIAL
  COMERCIAL
  MISTO
}

enum UnidadeStatusOcupacao {
  OCUPADA
  VAZIA
  EM_REFORMA
  MULTIPROPRIEDADE
}

enum UnidadeTipo {
  APARTAMENTO
  COMERCIAL
  GARAGEM
  DEPOSITO
  OUTROS
}

enum OcupanteVinculo {
  PROPRIETARIO
  LOCATARIO
  PROMITENTE_COMPRADOR
  CESSIONARIO
  MULTIPROPRIETARIO
  CONJUGE
  DEPENDENTE
}

enum TipoPeriodoOcupante {
  FIXO
  FLUTUANTE
  MISTO
}

enum OcorrenciaStatus {
  ABERTA
  EM_ANALISE
  RESOLVIDA
}

enum OcorrenciaTipo {
  BARULHO
  CONFLITO
  MANUTENCAO
  RECLAMACAO
  OUTRO
}

enum EncomendaStatus {
  PENDENTE
  RETIRADA
  DEVOLVIDA
  EXTRAVIADA
}

enum EncomendaTipo {
  CORREIOS
  TRANSPORTADORA
  DELIVERY
  OUTROS
}

enum ReservaStatus {
  PENDENTE_APROVACAO
  APROVADA
  REJEITADA
  CANCELADA_PELO_MORADOR
  CONCLUIDA
}

enum VisitanteStatus {
  NO_LOCAL
  SAIU
}

enum PublicoDestino {
  TODOS
  PROPRIETARIOS
  INQUILINOS
  FUNCIONARIOS
}

enum ContratoStatus {
  ATIVO
  A_VENCER
  FINALIZADO
  RESCINDIDO
}

// ============================================================
// PESSOA / USUÁRIO
// ============================================================

model Pessoa {
  pesCod           Int        @id @default(autoincrement()) @map("pes_cod")
  pesNome          String     @map("pes_nome") @db.VarChar(100)
  pesCpfCnpj       String     @unique @map("pes_cpf_cnpj") @db.VarChar(14)
  pesTipo          PessoaTipo @default(F) @map("pes_tipo")
  pesEmail         String     @unique @map("pes_email") @db.VarChar(100)
  pesTelefone      String?    @map("pes_telefone") @db.VarChar(20)
  pesTelefone2     String?    @map("pes_telefone2") @db.VarChar(20)
  pesAtivo         Boolean    @default(true) @map("pes_ativo")
  pesDtCadastro    DateTime   @default(now()) @map("pes_dt_cadastro") @db.Timestamp(6)
  pesDtAtualizacao DateTime?  @updatedAt @map("pes_dt_atualizacao") @db.Timestamp(6)
  pesSenhaLogin    String?    @map("pes_senha_login") @db.VarChar(255)
  pesIsGlobalAdmin Boolean    @default(false) @map("pes_is_global_admin")
  pesImagem        Bytes?     @map("pes_imagem")

  ocupacoes               Ocupante[]
  papeis                  UsuarioCondominio[]
  ocorrenciasRegistradas  Ocorrencia[]             @relation("OcorrenciaRegistroPor")
  ocorrenciasFinalizadas  Ocorrencia[]             @relation("OcorrenciaFinalizadaPor")
  comentariosOcorrencia   OcorrenciaComentario[]
  anexosOcorrencia        OcorrenciaAnexo[]
  comunicadosCriados      Comunicado[]             @relation("ComunicadoCriadoPor")
  leiturasComunicado      ComunicadoLeitura[]
  encomendasRegistradas   Encomenda[]              @relation("EncomendaRegistradaPor")
  encomendasRetiradas     Encomenda[]              @relation("EncomendaRetiradaPor")
  visitantesRegistrados   Visitante[]              @relation("VisitanteRegistradoPor")
  visitantesAutorizados   Visitante[]              @relation("VisitanteAutorizadoPor")
  reservasSolicitadas     Reserva[]                @relation("ReservaMorador")
  reservasAprovadas       Reserva[]                @relation("ReservaAprovador")
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]

  @@index([pesEmail])
  @@map("gc_pessoa")
}

// ============================================================
// REFRESH TOKEN (para auth mobile-friendly)
// ============================================================

model RefreshToken {
  id        String   @id @default(uuid())
  pesCod    Int      @map("pes_cod")
  pessoa    Pessoa   @relation(fields: [pesCod], references: [pesCod], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(6)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([pesCod])
  @@index([expiresAt])
  @@map("gc_refresh_token")
}

// ============================================================
// CONDOMÍNIO
// ============================================================

model Condominio {
  conCod                 Int                  @id @default(autoincrement()) @map("con_cod")
  conNome                String               @map("con_nome") @db.VarChar(100)
  conLogradouro          String?              @map("con_logradouro") @db.VarChar(100)
  conNumero              String?              @map("con_numero") @db.VarChar(10)
  conComplemento         String?              @map("con_complemento") @db.VarChar(50)
  conBairro              String?              @map("con_bairro") @db.VarChar(50)
  conCidade              String?              @map("con_cidade") @db.VarChar(50)
  conEstado              String?              @map("con_estado") @db.VarChar(2)
  conCep                 String?              @map("con_cep") @db.VarChar(8)
  conPais                String?              @default("Brasil") @map("con_pais") @db.VarChar(50)
  conReferencia          String?              @map("con_referencia") @db.VarChar(100)
  conNumeroUnidades      Int?                 @map("con_numero_unidades")
  conTipologia           CondominioTipologia  @map("con_tipologia")
  conDtVencimentoTaxa    Int?                 @map("con_dt_vencimento_taxa")
  conDtCadastro          DateTime             @default(now()) @map("con_dt_cadastro") @db.Timestamp(6)
  conDtAtualizacao       DateTime?            @updatedAt @map("con_dt_atualizacao") @db.Timestamp(6)
  conAtivo               Boolean              @default(true) @map("con_ativo")
  conGeracaoAutoAtiva    Boolean              @default(false) @map("con_geracao_auto_ativa")
  conDiaGeracaoCobranca  Int?                 @map("con_dia_geracao_cobranca")

  unidades        Unidade[]
  papeis          UsuarioCondominio[]
  contratos       Contrato[]
  ocorrencias     Ocorrencia[]
  encomendas      Encomenda[]
  visitantes      Visitante[]
  areasComuns     AreaComum[]
  comunicados     Comunicado[]          @relation("ComunicadoCondominio")

  @@map("gc_condominio")
}

// ============================================================
// UNIDADE
// ============================================================

model Unidade {
  uniCod             Int                   @id @default(autoincrement()) @map("uni_cod")
  conCod             Int                   @map("con_cod")
  condominio         Condominio            @relation(fields: [conCod], references: [conCod])
  uniNumero          String                @map("uni_numero") @db.VarChar(10)
  bloco              String?               @map("uni_bloco") @db.VarChar(50)
  andar              String?               @map("uni_andar") @db.VarChar(50)
  uniStatusOcupacao  UnidadeStatusOcupacao? @map("uni_status_ocupacao")
  fracaoIdeal        Decimal?              @map("uni_fracao_ideal") @db.Decimal(5, 2)
  areaPrivada        Decimal?              @map("uni_area_privada") @db.Decimal(10, 2)
  observacao         String?               @map("uni_observacao") @db.Text
  unidadeTipo        UnidadeTipo?          @map("uni_tipo")
  uniDtCadastro      DateTime              @default(now()) @map("uni_dt_cadastro") @db.Timestamp(6)
  uniDtAtualizacao   DateTime?             @updatedAt @map("uni_dt_atualizacao") @db.Timestamp(6)
  uniAtiva           Boolean               @default(true) @map("uni_ativa")

  ocupantes   Ocupante[]
  ocorrencias Ocorrencia[]
  encomendas  Encomenda[]
  visitantes  Visitante[]
  reservas    Reserva[]

  @@index([conCod])
  @@map("gc_unidade")
}

// ============================================================
// OCUPANTE (Pessoa <-> Unidade)
// ============================================================

model Ocupante {
  ocuCod              Int                 @id @default(autoincrement()) @map("ocu_cod")
  pesCod              Int                 @map("pes_cod")
  pessoa              Pessoa              @relation(fields: [pesCod], references: [pesCod])
  uniCod              Int                 @map("uni_cod")
  unidade             Unidade             @relation(fields: [uniCod], references: [uniCod])
  ocuVinculo          OcupanteVinculo     @map("ocu_vinculo")
  ocuDtInicioOcupacao DateTime?           @map("ocu_dt_inicio_ocupacao") @db.Date
  ocuDtFimOcupacao    DateTime?           @map("ocu_dt_fim_ocupacao") @db.Date
  ocuPeriodoUso       String?             @map("ocu_periodo_uso") @db.VarChar(100)
  ocuTipoPeriodo      TipoPeriodoOcupante? @map("ocu_tipo_periodo")
  ocuDtCadastro       DateTime            @default(now()) @map("ocu_dt_cadastro") @db.Timestamp(6)
  ocuDtAtualizacao    DateTime?           @updatedAt @map("ocu_dt_atualizacao") @db.Timestamp(6)

  @@unique([pesCod, uniCod])
  @@index([uniCod])
  @@map("gc_ocupante")
}

// ============================================================
// USUARIO <-> CONDOMINIO (ROLES)
// ============================================================

model UsuarioCondominio {
  pesCod              Int        @map("pes_cod")
  conCod              Int        @map("con_cod")
  uscPapel            UserRole   @map("usc_papel")
  uscDtAssociacao     DateTime   @default(now()) @map("usc_dt_associacao") @db.Timestamp(6)
  uscAtivoAssociacao  Boolean    @default(true) @map("usc_ativo_associacao")
  uscDtAtualizacao    DateTime?  @updatedAt @map("usc_dt_atualizacao") @db.Timestamp(6)

  pessoa     Pessoa     @relation(fields: [pesCod], references: [pesCod], onDelete: Cascade)
  condominio Condominio @relation(fields: [conCod], references: [conCod], onDelete: Cascade)

  @@id([pesCod, conCod, uscPapel])
  @@index([conCod])
  @@map("gc_usuario_condominio")
}

// ============================================================
// CONTRATO
// ============================================================

model Contrato {
  id              Int            @id @default(autoincrement()) @map("ctr_cod")
  conCod          Int            @map("con_cod")
  condominio      Condominio     @relation(fields: [conCod], references: [conCod])
  empresa         String         @map("ctr_empresa") @db.VarChar(100)
  servico         String         @map("ctr_servico") @db.VarChar(255)
  valor           Decimal        @map("ctr_valor") @db.Decimal(10, 2)
  responsavel     String?        @map("ctr_responsavel") @db.VarChar(100)
  status          ContratoStatus @map("ctr_status")
  dataInicio      DateTime       @map("ctr_data_inicio") @db.Date
  dataFim         DateTime       @map("ctr_data_fim") @db.Date
  observacoes     String?        @map("ctr_observacoes") @db.Text
  dataCadastro    DateTime       @default(now()) @map("ctr_dt_cadastro") @db.Timestamp(6)
  dataAtualizacao DateTime?      @updatedAt @map("ctr_dt_atualizacao") @db.Timestamp(6)

  @@index([conCod])
  @@map("gc_contrato")
}

// ============================================================
// OCORRÊNCIA
// ============================================================

model Ocorrencia {
  ocoCod           Int              @id @default(autoincrement()) @map("oco_cod")
  conCod           Int              @map("con_cod")
  condominio       Condominio       @relation(fields: [conCod], references: [conCod])
  uniCod           Int              @map("uni_cod")
  unidade          Unidade          @relation(fields: [uniCod], references: [uniCod])
  pesCodRegistro   Int              @map("pes_cod_registro")
  pessoaRegistro   Pessoa           @relation("OcorrenciaRegistroPor", fields: [pesCodRegistro], references: [pesCod])
  titulo           String           @db.VarChar(150)
  descricao        String           @db.Text
  tipo             OcorrenciaTipo
  status           OcorrenciaStatus @default(ABERTA)
  dataRegistro     DateTime         @default(now()) @map("data_registro") @db.Timestamp(6)
  dataAtualizacao  DateTime?        @updatedAt @map("data_atualizacao") @db.Timestamp(6)
  parecerFinal     String?          @map("parecer_final") @db.Text
  pesCodFinalizou  Int?             @map("pes_cod_finalizou")
  pessoaFinalizou  Pessoa?          @relation("OcorrenciaFinalizadaPor", fields: [pesCodFinalizou], references: [pesCod])
  dataFinalizacao  DateTime?        @map("data_finalizacao") @db.Timestamp(6)

  comentarios OcorrenciaComentario[]
  anexos      OcorrenciaAnexo[]

  @@index([conCod])
  @@index([uniCod])
  @@index([status])
  @@map("gc_ocorrencia")
}

model OcorrenciaComentario {
  occCod            Int        @id @default(autoincrement()) @map("occ_cod")
  ocoCod            Int        @map("oco_cod")
  ocorrencia        Ocorrencia @relation(fields: [ocoCod], references: [ocoCod], onDelete: Cascade)
  pesCodComentario  Int        @map("pes_cod_comentario")
  pessoa            Pessoa     @relation(fields: [pesCodComentario], references: [pesCod])
  comentario        String     @db.Text
  dataComentario    DateTime   @default(now()) @map("data_comentario") @db.Timestamp(6)

  @@index([ocoCod])
  @@map("gc_ocorrencia_comentario")
}

model OcorrenciaAnexo {
  ocaCod          Int        @id @default(autoincrement()) @map("oca_cod")
  ocoCod          Int        @map("oco_cod")
  ocorrencia      Ocorrencia @relation(fields: [ocoCod], references: [ocoCod], onDelete: Cascade)
  pesCodAnexo     Int        @map("pes_cod_anexo")
  pessoa          Pessoa     @relation(fields: [pesCodAnexo], references: [pesCod])
  caminhoArquivo  String     @map("caminho_arquivo") @db.VarChar(555)
  nomeOriginal    String?    @map("nome_original") @db.VarChar(255)
  tipoArquivo     String?    @map("tipo_arquivo") @db.VarChar(100)
  tamanhoArquivo  BigInt?    @map("tamanho_arquivo")
  dataAnexo       DateTime   @default(now()) @map("data_anexo") @db.Timestamp(6)

  @@index([ocoCod])
  @@map("gc_ocorrencia_anexo")
}

// ============================================================
// COMUNICADO
// ============================================================

model Comunicado {
  comCod          Int             @id @default(autoincrement()) @map("com_cod")
  titulo          String          @map("com_titulo") @db.VarChar(255)
  mensagem        String          @map("com_mensagem") @db.Text
  publicoDestino  PublicoDestino  @map("com_publico_destino")
  isUrgente       Boolean         @default(false) @map("com_is_urgente")
  caminhoAnexo    String?         @map("com_caminho_anexo") @db.VarChar(555)
  dataCadastro    DateTime        @default(now()) @map("com_dt_cadastro") @db.Timestamp(6)
  pesCodCriador   Int             @map("pes_cod_criador")
  pessoaCriador   Pessoa          @relation("ComunicadoCriadoPor", fields: [pesCodCriador], references: [pesCod])

  condominios Condominio[]         @relation("ComunicadoCondominio")
  leituras    ComunicadoLeitura[]

  @@map("gc_comunicado")
}

model ComunicadoLeitura {
  comCod      Int        @map("com_cod")
  pesCod      Int        @map("pes_cod")
  dataLeitura DateTime   @default(now()) @map("cle_dt_leitura") @db.Timestamp(6)

  comunicado Comunicado @relation(fields: [comCod], references: [comCod], onDelete: Cascade)
  pessoa     Pessoa     @relation(fields: [pesCod], references: [pesCod])

  @@id([comCod, pesCod])
  @@map("gc_comunicado_leitura")
}

// ============================================================
// ENCOMENDA
// ============================================================

model Encomenda {
  encCod                  BigInt          @id @default(autoincrement()) @map("enc_cod")
  conCod                  Int             @map("con_cod")
  condominio              Condominio      @relation(fields: [conCod], references: [conCod])
  uniCod                  Int             @map("uni_cod")
  unidade                 Unidade         @relation(fields: [uniCod], references: [uniCod])
  pesCodRegistro          Int             @map("pes_cod_registro")
  pessoaRegistro          Pessoa          @relation("EncomendaRegistradaPor", fields: [pesCodRegistro], references: [pesCod])
  destinatario            String          @db.VarChar(100)
  nomeRecebidoPor         String          @map("nome_recebido_por") @db.VarChar(100)
  descricao               String?         @db.VarChar(255)
  tipo                    EncomendaTipo
  status                  EncomendaStatus @default(PENDENTE)
  dataRecebimento         DateTime        @map("data_recebimento") @db.Timestamp(6)
  observacoes             String?         @db.Text
  nomeRetirada            String?         @map("nome_retirada") @db.VarChar(100)
  pesCodRetirada          Int?            @map("pes_cod_retirada")
  pessoaRetirada          Pessoa?         @relation("EncomendaRetiradaPor", fields: [pesCodRetirada], references: [pesCod])
  dataRetirada            DateTime?       @map("data_retirada") @db.Timestamp(6)
  observacaoAtualizacao   String?         @map("observacao_atualizacao") @db.Text
  dataAtualizacaoStatus   DateTime?       @map("data_atualizacao_status") @db.Timestamp(6)

  @@index([conCod])
  @@index([uniCod])
  @@index([status])
  @@map("gc_encomenda")
}

// ============================================================
// VISITANTE
// ============================================================

model Visitante {
  visCod          Int              @id @default(autoincrement()) @map("vis_cod")
  conCod          Int              @map("con_cod")
  condominio      Condominio       @relation(fields: [conCod], references: [conCod])
  uniCod          Int              @map("uni_cod")
  unidade         Unidade          @relation(fields: [uniCod], references: [uniCod])
  pesCodMorador   Int?             @map("pes_cod_morador")
  pessoaMorador   Pessoa?          @relation("VisitanteAutorizadoPor", fields: [pesCodMorador], references: [pesCod])
  pesCodRegistro  Int              @map("pes_cod_registro")
  pessoaRegistro  Pessoa           @relation("VisitanteRegistradoPor", fields: [pesCodRegistro], references: [pesCod])
  nome            String           @db.VarChar(100)
  cpf             String?          @db.VarChar(14)
  rg              String?          @db.VarChar(20)
  telefone        String?          @db.VarChar(20)
  status          VisitanteStatus  @default(NO_LOCAL)
  dataEntrada     DateTime         @map("data_entrada") @db.Timestamp(6)
  dataSaida       DateTime?        @map("data_saida") @db.Timestamp(6)
  observacoes     String?          @db.Text
  dataCadastro    DateTime         @default(now()) @map("data_cadastro") @db.Timestamp(6)
  dataAtualizacao DateTime?        @updatedAt @map("data_atualizacao") @db.Timestamp(6)

  @@index([conCod])
  @@index([uniCod])
  @@index([status])
  @@map("gc_visitante")
}

// ============================================================
// ÁREA COMUM + TURNO + RESERVA
// ============================================================

model AreaComum {
  areCod              Int         @id @default(autoincrement()) @map("are_cod")
  conCod              Int         @map("con_cod")
  condominio          Condominio  @relation(fields: [conCod], references: [conCod])
  nome                String      @db.VarChar(100)
  descricao           String?     @db.Text
  termosUso           String?     @map("termos_uso") @db.Text
  capacidadeMaxima    Int?        @map("capacidade_maxima")
  permiteConvidados   Boolean     @default(false) @map("permite_convidados")
  limiteConvidados    Int?        @map("limite_convidados")
  diasAntecedenciaMin Int         @default(1) @map("dias_antecedencia_min")
  diasAntecedenciaMax Int         @default(30) @map("dias_antecedencia_max")
  ativa               Boolean     @default(true)
  taxaValor           Decimal?    @map("taxa_valor") @db.Decimal(10, 2)
  dataCadastro        DateTime    @default(now()) @map("data_cadastro") @db.Timestamp(6)
  dataAtualizacao     DateTime?   @updatedAt @map("data_atualizacao") @db.Timestamp(6)

  turnos   AreaComumTurno[]
  reservas Reserva[]

  @@index([conCod])
  @@map("gc_area_comum")
}

model AreaComumTurno {
  turCod     Int       @id @default(autoincrement()) @map("tur_cod")
  areCod     Int       @map("are_cod")
  areaComum  AreaComum @relation(fields: [areCod], references: [areCod], onDelete: Cascade)
  nome       String    @db.VarChar(50)
  horaInicio DateTime  @map("hora_inicio") @db.Time(6)
  horaFim    DateTime  @map("hora_fim") @db.Time(6)
  ativo      Boolean   @default(true)

  reservas Reserva[]

  @@index([areCod])
  @@map("gc_area_comum_turno")
}

model Reserva {
  resCod          Int             @id @default(autoincrement()) @map("res_cod")
  areCod          Int             @map("are_cod")
  areaComum       AreaComum       @relation(fields: [areCod], references: [areCod])
  turCod          Int?            @map("tur_cod")
  turno           AreaComumTurno? @relation(fields: [turCod], references: [turCod])
  uniCod          Int             @map("uni_cod")
  unidade         Unidade         @relation(fields: [uniCod], references: [uniCod])
  pesCodMorador   Int             @map("pes_cod_morador")
  morador         Pessoa          @relation("ReservaMorador", fields: [pesCodMorador], references: [pesCod])
  pesCodAprovador Int?            @map("pes_cod_aprovador")
  aprovador       Pessoa?         @relation("ReservaAprovador", fields: [pesCodAprovador], references: [pesCod])
  data            DateTime        @db.Date
  status          ReservaStatus   @default(PENDENTE_APROVACAO)
  termosAceitos   Boolean         @default(false) @map("termos_aceitos")
  motivoRejeicao  String?         @map("motivo_rejeicao") @db.Text
  dataRegistro    DateTime        @default(now()) @map("data_registro") @db.Timestamp(6)
  dataAtualizacao DateTime?       @updatedAt @map("data_atualizacao") @db.Timestamp(6)

  convidados ReservaConvidado[]

  @@index([areCod])
  @@index([status])
  @@map("gc_reserva")
}

model ReservaConvidado {
  rcvCod    Int     @id @default(autoincrement()) @map("rcv_cod")
  resCod    Int     @map("res_cod")
  reserva   Reserva @relation(fields: [resCod], references: [resCod], onDelete: Cascade)
  nome      String  @db.VarChar(150)
  documento String? @db.VarChar(50)

  @@index([resCod])
  @@map("gc_reserva_convidado")
}

// ============================================================
// PASSWORD RESET
// ============================================================

model PasswordResetToken {
  token     String   @id @db.VarChar(128)
  pesCod    Int      @map("pes_cod")
  pessoa    Pessoa   @relation(fields: [pesCod], references: [pesCod], onDelete: Cascade)
  expiracao DateTime @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([pesCod])
  @@index([expiracao])
  @@map("gc_password_reset_token")
}
