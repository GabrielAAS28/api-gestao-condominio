# ==========================
# Ambiente
# ==========================
NODE_ENV=development
PORT=3000

# ==========================
# Banco de dados
# ==========================
# String usada DENTRO do docker-compose (serviço postgres)
DATABASE_URL="postgresql://admin:admin@postgres:5432/condigtal_dev?schema=public"
# Se rodar o Node localmente (fora do Docker) apontando para o Postgres do compose:
# DATABASE_URL="postgresql://admin:admin@localhost:5432/condigtal_dev?schema=public"

POSTGRES_DB=condigtal_dev
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# ==========================
# JWT
# ==========================
JWT_ACCESS_SECRET=troque-este-segredo-em-producao-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-este-segredo-em-producao-refresh
JWT_REFRESH_EXPIRES_IN=7d

# ==========================
# Upload
# ==========================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ==========================
# CORS
# ==========================
# Lista separada por vírgula. Use * para liberar geral em dev.
CORS_ORIGINS=*

# ==========================
# Email (Gmail SMTP - App Password)
# ==========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=seu-email@gmail.com
MAIL_PASSWORD=sua-app-password
MAIL_FROM_NAME=CONDIGTAL
MAIL_FROM_ADDRESS=seu-email@gmail.com

# ==========================
# Reset de senha
# ==========================
PASSWORD_RESET_TTL_HOURS=2
PASSWORD_RESET_BASE_URL=http://localhost:3000/auth/reset-password

# ==========================
# Leads (endpoint público)
# ==========================
LEAD_NOTIFICATION_EMAILS=admin@condigtal.com

# ==========================================================
# DEPLOY NO RAILWAY — leia RAILWAY-DEPLOY.md
# ==========================================================
# No Railway NAO defina PORT (a plataforma injeta sozinha) e NAO use
# os valores de exemplo acima. O que muda em producao:
#
#   DATABASE_URL            -> referencie o Postgres do Railway com a
#                              sintaxe de variavel: ${{ Postgres.DATABASE_URL }}
#   NODE_ENV                -> production
#   JWT_ACCESS_SECRET       -> gere com: openssl rand -base64 48
#   JWT_REFRESH_SECRET      -> gere outro, DIFERENTE do de acesso
#   CORS_ORIGINS            -> dominios reais separados por virgula (nunca *)
#   UPLOAD_DIR              -> /app/uploads, com um Railway Volume montado
#                              nesse caminho. Sem o volume os arquivos somem
#                              a cada redeploy (filesystem efemero).
#   PASSWORD_RESET_BASE_URL -> URL publica real do servico
